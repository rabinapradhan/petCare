<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/petcare_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_padding">



        <FrameLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="@color/petcare_background"
            android:clipToOutline="true">


            <!-- ================================================= -->
            <!-- FULL-SCREEN CAT + DOG IMAGE -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/petHeroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/petcare_hero" />


            <!-- ================================================= -->
            <!-- DARK / SOFT OVERLAY FOR TEXT READABILITY -->
            <!-- ================================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000" />


            <!-- ================================================= -->
            <!-- CONTENT OVER IMAGE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingEnd="@dimen/screen_horizontal_padding">



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="35dp"

                     >


                    <!-- Logo -->

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_green"
                        android:padding="9dp"
                        android:src="@drawable/ic_pet_profile"
                        android:contentDescription="@string/app_name"
                        app:tint="@color/white" />





                    <!-- App name -->

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />


                    <!-- Sign In -->

                    <TextView
                        android:id="@+id/signInButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:minHeight="40dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/sign_in"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- ================= HERO CONTENT ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:orientation="vertical">


                    <!-- HERO TITLE -->

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/hero_title"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />


                    <!-- HERO DESCRIPTION -->

                    <TextView
                        android:id="@+id/heroDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/hero_description"
                        android:textColor="@color/white"
                        android:textSize="16sp" />


                    <!-- GET STARTED -->

                    <TextView
                        android:id="@+id/getStartedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_button_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="140dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/get_started"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>


        <!-- ================================================= -->
        <!-- CONTENT BELOW FIRST SCREEN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding">


            <!-- ================================================= -->
            <!-- PET PROFILE CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/petProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_pet_profile"
                    android:contentDescription="@string/pet_profiles" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/pet_profiles"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/pet_profiles_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARE CHECKLIST CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/careChecklistCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_checklist"
                    android:contentDescription="@string/care_checklists" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/care_checklists"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/care_checklists_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SMS DELEGATION CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/delegateSmsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/delegate_sms" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/delegate_sms"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/delegate_sms_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EXPENSE CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/expenseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_wallet"
                    android:contentDescription="@string/expense_tracking" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/expense_tracking"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/expense_tracking_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- GEOTAGGED PLACES CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/geotaggedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="@string/geotagged_places" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/geotagged_places"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/geotagged_places_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- REMINDER CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/reminderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="@string/reminders" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/reminders"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/reminders_description"
                    android:textColor="@color/petcare_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BOTTOM CTA -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/createAccountSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cta_margin_top"
                android:background="@drawable/bg_cta"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/cta_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/cta_title"
                    android:textColor="@color/petcare_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/cta_description"
                    android:textColor="@color/petcare_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/createAccountButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_button_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="188dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/create_account"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- Bottom spacing -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_padding" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>