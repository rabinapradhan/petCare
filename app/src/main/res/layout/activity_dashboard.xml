<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".DashboardActivity">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="22dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@color/pet_background">

        <!-- LOGO -->

        <ImageView
            android:id="@+id/logoIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pet_profile2"
            android:background="@drawable/bg_button_green"
            app:tint="@android:color/white" />


        <!-- GREETING -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi PetCare Pro"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Here is today's care overview"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- LOGOUT -->

        <ImageButton
            android:id="@+id/logoutButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_logout"
            android:contentDescription="Logout"
            android:background="@drawable/bg_light_green"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/black" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- HEADER DIVIDER -->
    <!-- ========================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_green" />


    <!-- ========================================================= -->
    <!-- SCROLL CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="18dp"
            android:paddingEnd="15dp"
            android:paddingBottom="18dp">


            <!-- ================================================= -->
            <!-- TODAY'S CHECKLIST -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/bg_light_green">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S CHECKLIST"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/checklistDoneText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0/0 done"
                        android:textColor="@color/black"
                        android:textSize="29sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checklistPercentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/black"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- PROGRESS -->

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_progress" />


                <!-- OPEN CHECKLIST -->

                <TextView
                    android:id="@+id/openChecklistButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Open checklist    →"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:background="@drawable/bg_outline_card"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>



            <!-- ================================================= -->
            <!-- STATISTICS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">


                <!-- PETS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/petCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pets"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <Space
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />


                <!-- PLACES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/placeCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Places"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <Space
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />


                <!-- SPEND -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:id="@+id/spendText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spend"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- STILL DUE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Still due"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/stillDueContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />


            <!-- Empty/default message -->

            <TextView
                android:id="@+id/stillDueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="18dp"
                android:text="Nothing outstanding. Add care tasks from a pet's profile to build a routine."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:background="@drawable/bg_card"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- MY PETS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="My pets"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/myPetsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="142dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/myPetsContainer"
                        android:textAlignment="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />

                </HorizontalScrollView>


                <!-- CUSTOM SCROLLBAR -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="23dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- LEFT ARROW -->

                    <TextView
                        android:id="@+id/petScrollLeft"
                        android:layout_width="18dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:text="◀"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp" />

                    <!-- TRACK -->

                    <View
                        android:id="@+id/petScrollTrack"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_pet_scroll_track" />

                    <!-- RIGHT ARROW -->

                    <TextView
                        android:id="@+id/petScrollRight"
                        android:layout_width="18dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#8A8A8A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- TIP -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textColor="@color/dark_green"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tip: open a checklist and tap the send icon to text the plan to a family member or pet sitter."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <include
        layout="@layout/bottom_navigation" />

</LinearLayout>