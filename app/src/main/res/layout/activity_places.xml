<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".PlacesActivity">


    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@color/pet_background">

            <!-- LOGO -->

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pet_profile2"
                android:background="@drawable/bg_button_green"
                app:tint="@android:color/white" />


        <!-- Header text -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pet places"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vets, groomers, parks, and stores"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- Add -->

        <TextView
            android:id="@+id/addPlaceButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:background="@drawable/bg_button_green" />

    </LinearLayout>


    <!-- HEADER DIVIDER -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_green" />


    <!-- ====================================================== -->
    <!-- CONTENT -->
    <!-- ====================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================== -->
            <!-- MAP -->
            <!-- ================================================== -->

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp" />


            <!-- ================================================== -->
            <!-- LOCATION + FILTER -->
            <!-- ================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <LinearLayout
                    android:id="@+id/useLocationButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_light_green"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_my_location"
                        android:contentDescription="@null"
                        app:tint="@color/dark_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use my location"
                        android:textColor="@color/dark_green"
                        android:textSize="14sp"
                        android:includeFontPadding="false" />

                </LinearLayout>

                <Spinner
                    android:id="@+id/typeFilterSpinner"
                    android:layout_width="190dp"
                    android:layout_height="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_outline_card"
                    android:spinnerMode="dropdown" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- CATEGORY CHIPS -->
            <!-- ================================================== -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:scrollbars="none"
              >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🔴  Veterinary clinic"
                        android:textColor="#405148"
                        android:textSize="12sp"
                        android:background="@drawable/bg_light_green" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🟣  Grooming salon"
                        android:textColor="#405148"
                        android:textSize="12sp"
                        android:background="@drawable/bg_light_green" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🟢  Dog park"
                        android:textColor="#405148"
                        android:textSize="12sp"
                        android:background="@drawable/bg_light_green" />

                </LinearLayout>

            </HorizontalScrollView>


            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🔵  Pet supply store"
                        android:textColor="#405148"
                        android:textSize="12sp"
                        android:background="@drawable/bg_light_green" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🟠  Animal shelter"
                        android:textColor="#405148"
                        android:textSize="12sp"
                        android:background="@drawable/bg_light_green" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================== -->
            <!-- EMPTY STATE -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/noPlacesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:padding="20dp"
                android:text="No places yet. Tap the plus button, allow location or search by name, then save your vet, groomer or favourite dog park."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_card" />


            <!-- ================================================== -->
            <!-- SAVED PLACES -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/placesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical" />


        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <include
        layout="@layout/bottom_navigation" />

</LinearLayout>