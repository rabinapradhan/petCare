<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_pet_card"
    android:elevation="2dp">


    <TextView
        android:id="@+id/taskIconText"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="♧"
        android:textSize="21sp"
        android:textColor="#2F844B"
        android:background="@drawable/bg_light_green"/>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/taskTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="walk"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#18231B"/>

        <TextView
            android:id="@+id/taskDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Exercise · 01:59 · Every day"
            android:textSize="13sp"
            android:textColor="#68766D"/>

        <TextView
            android:id="@+id/taskSuppliesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Supplies: leash"
            android:textSize="12sp"
            android:textColor="#68766D"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/editTaskButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_light_green"
        android:src="@drawable/ic_edit"
        android:padding="10dp"
        android:contentDescription="Edit task"
        android:clickable="true"
        android:focusable="true"/>

    <!-- ===================================================== -->
    <!-- DELETE BUTTON -->
    <!-- ===================================================== -->

    <ImageButton
        android:id="@+id/deleteTaskButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_light_green"
        android:src="@drawable/ic_delete"
        android:padding="8dp"
        android:contentDescription="Delete task"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>